# Supply these at runtime; do not save real credentials in this file.
SCHULCLOUD_EMAIL=
SCHULCLOUD_PASSWORD=
SCHULCLOUD_SECURITY_PASSWORD=
# Optional: defaults to ./archive-data
SCHULCLOUD_ARCHIVE_DIR=
# Optional: interface the viewer binds to, defaults to 127.0.0.1. Only Docker
# needs 0.0.0.0, since a container cannot be entered on the loopback address.
# HOST=
# Optional: port, defaults to 4317
# PORT=

# --- Blob storage (Anhänge und Profilbilder) --------------------------------
# "file" keeps everything under archive-data/blobs/, "s3" uses an object store.
# The viewer's settings page (gear button in the sidebar) can switch this too;
# anything set here wins over what the settings page saves.
# SCHULCLOUD_STORAGE=file
# Endpoint is optional: left empty, the SDK uses the regional AWS endpoint.
# SCHULCLOUD_S3_ENDPOINT=
# SCHULCLOUD_S3_REGION=us-east-1
# SCHULCLOUD_S3_BUCKET=
# SCHULCLOUD_S3_ACCESS_KEY_ID=
# SCHULCLOUD_S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket, so several archives can share one bucket.
# SCHULCLOUD_S3_PREFIX=
# Path-style URLs, which MinIO and other small providers require.
# SCHULCLOUD_S3_PATH_STYLE=0

# Docker only: interface and port published on the host by compose.yaml.
# SCHULCLOUD_BIND=127.0.0.1
# SCHULCLOUD_PORT=4317
