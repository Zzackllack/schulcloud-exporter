{
  "name": "schulcloud-exporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "sync": "node src/cli.mjs import",
    "serve": "pnpm build && node src/cli.mjs serve",
    "dev": "node src/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node src/cli.mjs serve",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint",
    "export": "node src/cli.mjs export",
    "repair": "node src/cli.mjs repair",
    "migrate": "node src/cli.mjs migrate",
    "test": "pnpm build && node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "stashcat-api": "github:dclausen01/stashcat-api#8c179a6fba802019f7ed09b2419a68b7c0c458d2"
  },
  "packageManager": "pnpm@11.11.0",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lucide-react": "^1.48.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^8.3.3"
  }
}
